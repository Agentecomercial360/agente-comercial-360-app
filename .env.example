# Supabase correspondente ao ambiente do frontend e da API.
# Preview deve usar somente o projeto isolado de homologação.
# Usar SOMENTE a anon key no front-end. Nunca colocar a service_role aqui.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL obrigatória: somente a origem HTTP(S), sem /api ou credenciais.
# Não há fallback automático. Variáveis VITE_* são públicas e entram no build.
# Desenvolvimento: http://localhost:3001 (backend local configurado para teste).
# Vercel Preview da branch feature/ac360-multiconsultor:
# https://ac360-mercadolivre-api-staging-staging.up.railway.app
# Produção: definir explicitamente a URL aprovada da API de produção somente
# no ambiente Production. Nunca reutilizar essa configuração no Preview.
VITE_AC360_API_URL=
